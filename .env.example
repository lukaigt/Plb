# Polymarket Wallet Private Key (Polygon wallet connected to Polymarket)
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Polymarket CLOB API Credentials
# Get from: https://polymarket.com -> Settings -> API Keys -> Create API Key
POLY_API_KEY=your_poly_api_key_here
POLY_API_SECRET=your_poly_api_secret_here
POLY_PASSPHRASE=your_poly_passphrase_here

# Dashboard port (VPS = 4000)
PORT=4000

# Risk Controls
DAILY_LOSS_LIMIT=30      # Bot stops for the day if total losses hit this amount (USD)
MAX_DAILY_TRADES=6       # Max trades per day before bot stops

# Proxy (optional — helps avoid Cloudflare blocks)
# PROXY_URL=http://user:pass@host:port

# Soccer Bond Bot
SOCCER_ENABLED=true
BOND_THRESHOLD=0.95      # Buy YES token when price hits this (0.95 = 95¢)
BOND_ORDER_SIZE=5        # USD per bet
BOND_MAX_POSITIONS=5     # Max open bets at the same time
BOND_MIN_VOLUME=5000     # Only bet on markets with at least this much 24hr volume
