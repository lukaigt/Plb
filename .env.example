# OpenRouter API Key (for AI predictions)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Polymarket Wallet Private Key (Metamask wallet connected to Polymarket)
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Polymarket CLOB API Credentials (get from Polymarket Builder's Dashboard)
# Go to: https://polymarket.com -> Settings -> API Keys -> Create API Key
POLY_API_KEY=your_poly_api_key_here
POLY_API_SECRET=your_poly_api_secret_here
POLY_PASSPHRASE=your_poly_passphrase_here

# Trading Settings
MAX_TRADE_SIZE=5
DAILY_LOSS_LIMIT=15

# Momentum Strategy Settings
MOM_ORDER_SIZE=5              # Fixed order size in USD (used if MOM_ORDER_PCT not set)
# MOM_ORDER_PCT=0.05          # % of wallet balance per trade (e.g. 0.05 = 5%). Overrides MOM_ORDER_SIZE if set.
# MOM_ORDER_PCT_MIN=2         # Minimum order size in USD when using percentage sizing
# MOM_ORDER_PCT_MAX=20        # Maximum order size in USD when using percentage sizing
MOM_VOL_FILTER=true           # Skip entry when BTC 1m and 3m signals disagree (choppy market filter)
MOM_TAKE_PROFIT=0.70          # Sell early when token mid reaches this price
MOM_STOP_LOSS=0.18            # Exit when token drops this far below entry
MOM_TRAILING_ACTIVATE=0.10    # Activate trailing stop when token is this far above entry
MOM_TRAILING_STOP=0.05        # Trail this far below peak (floor = entry price)
MOM_THRESHOLD=0.05            # BTC 3-min % change required for a signal
MOM_MAX_FLIPS=3               # Max re-entries per market window

# Dashboard Port (default 4000, change if needed)
PORT=4000

# Bot Scan Interval in seconds (how often to check markets)
SCAN_INTERVAL=120

# Soccer Live Bond Bot Settings
SOCCER_ENABLED=true             # Set to false to disable the soccer bot entirely
BOND_THRESHOLD=0.95             # Buy YES token when mid-price reaches this (0.95 = 95¢)
BOND_ORDER_SIZE=5               # Fixed order size in USD per soccer trade
BOND_MAX_POSITIONS=5            # Max concurrent open soccer positions
BOND_MIN_VOLUME=5000            # Minimum 24hr market volume required to consider entry (USD)
BOND_DAILY_MAX_SPEND=50         # Max total USD to spend on soccer trades per day

# Proxy URL (optional - use to avoid Cloudflare blocking)
# Format: http://username:password@host:port or http://host:port
# PROXY_URL=http://user:pass@proxy-server.com:8080
